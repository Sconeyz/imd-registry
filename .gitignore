out/
cache/
# forge-std v1.16.2 vendored by forge init (no .git, untracked; upstream
# https://github.com/foundry-rs/forge-std, tag v1.16.2). Test-only: not part
# of the deployed contract's code, but the remapping to it is part of the
# compiler metadata, so remappings.txt (tracked) pins it and a clone without
# lib/ reproduces the deployed metadata hash.
lib/
# local env files (RPC URLs, keys) — never tracked
.env*
# forge script broadcast records (tx data, sender, local paths) — never tracked
broadcast/
